# Agent Commerce Gateway (ACG) Environment Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# SERVER-ONLY SECRETS — set real values in your deployment platform.
# Do not use VITE_* for any of these values and do not commit .env.
ACG_ADMIN_TOKEN=
ACG_VIEWER_TOKEN=
ACG_AUDIT_TOKEN=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Database Configuration
DATABASE_PATH=./data/acg_gateway.db

# Vercel only: this admits the explicitly non-durable in-memory demo mode.
# It never relaxes authorization, webhook verification, or audit controls.
VERCEL_DEMO=0

# Merchant Configuration
MERCHANT_ID=merch_acme_electronics_01
MERCHANT_NAME=Acme Electronics Store
