  "license": "MIT",
  "dependencies": {
    "@fastify/bearer-auth": "^10.1.3",
    "@fastify/rate-limit": "^11.2.0",
    "@noble/ed25519": "^2.2.3",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.38.0",
    "pino": "^9.6.0",
    "razorpay": "^2.9.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
